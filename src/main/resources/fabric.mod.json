{
  "schemaVersion": 1,
  "id": "emeraldtools",
  "version": "${version}",
  "name": "Emerald Tools",
  "description": "Adds emerald tools to Better Than Wolves CE",
  "authors": [
    "jeffyjamzhd"
  ],
  "contact": {
    "homepage": "https://legacyfabric.net/",
    "sources": "https://github.com/Legacy-Fabric/fabric-example-mod"
  },
  "license": "CC0-1.0",
  "icon": "assets/emeraldtools/icon.png",
  "environment": "*",
  "entrypoints": {
    "btw:addon": ["com.jeffyjamzhd.emeraldtools.EmeraldToolsAddon"]
  },
  "custom": {
    "btw:addon_prefix": "EMT",
    "loom:injected_interfaces": {
      "net/minecraft/src/EnumToolMaterial" : ["com/jeffyjamzhd/emeraldtools/impl/IEnumToolMaterial"]
    }
  },
  "mixins": [
    "emeraldtools.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.14.19",
    "minecraft": "1.6.4",
    "btw" : ">=3.0.0"
  }
}
